#!/usr/bin/env bash
# Auto-bumps the calendar version on every commit and stages the result.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Skip during merge/rebase commits — version bump belongs to regular work commits only.
if [[ -e "$REPO_ROOT/.git/MERGE_HEAD" ]] || [[ -d "$REPO_ROOT/.git/rebase-merge" ]] || [[ -d "$REPO_ROOT/.git/rebase-apply" ]]; then
    exit 0
fi

"$REPO_ROOT/scripts/bump-version.sh"
git add "$REPO_ROOT/backend/app/config.py" "$REPO_ROOT/frontend/src/App.tsx"
